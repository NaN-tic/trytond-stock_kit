msgctxt "field:product.product,stock_depends_on_kit_components:"
msgid "Stock Depends on Components"
msgstr "L'estoc depèn dels components"

msgctxt "help:product.product,stock_depends_on_kit_components:"
msgid ""
"Indicates weather the stock of the current kit should depend on its "
"components or not."
msgstr "Indica si l'estoc del kit actual depèn dels seus components o no."

msgctxt "field:product.product,kit_available_quantity:"
msgid "Available Kit Quantity"
msgstr "Kits muntables"

msgctxt "field:stock.products_by_locations,kit_available_quantity:"
msgid "Available Kit Quantity"
msgstr "Kits muntables"

msgctxt "help:product.product,kit_available_quantity:"
msgid "The number of kits that can be assembled from the current stock of their components."
msgstr "El nombre de kits que es poden muntar amb l'estoc actual dels seus components."
